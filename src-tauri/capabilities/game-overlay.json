{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "game-overlay",
  "description": "Overlay: event communication and moving/closing only. No filesystem, shell, updater or credential access.",
  "windows": ["game-overlay"],
  "permissions": ["core:event:allow-listen", "core:event:allow-unlisten", "core:event:allow-emit-to", "core:window:allow-start-dragging", "core:window:allow-close"]
}
