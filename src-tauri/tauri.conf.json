{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tvinoferma",
  "version": "0.2.2",
  "identifier": "com.tvinoferma.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev -- --port 1420 --strictPort",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Твиноферма",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "ru-RU"
  }
}
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/drednight/Tvinoferma/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYzQjVGNjQyQjRDODAyN0QKUldSOUFzaTBRdmExODRIeThnWms0YU02WFNWYVR5emh0RkRBdnBHSG95dG1rb3lTZ2hUWDZxdXQK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
