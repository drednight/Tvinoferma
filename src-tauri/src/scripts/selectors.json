{
  "version": 1,
  "selectors": {
    "common.challengeScript": ["script[src*=\"bp_chl\"]"],

    "balance.container": [".points_info"],
    "balance.value": ["strong"],
    "balance.userMarker": [
      ".user-nick",
      ".header-user-name",
      "[class*=\"username\"]",
      ".info__forumname",
      "a[href*=\"usercp.php\"] > strong"
    ],

    "auth.nick": [".info__forumname"],

    "titles.heading": ["h2"],

    "marathon.heading": ["h2"],
    "marathon.legend": [".status_legend"],
    "marathon.container": [".season_marathon"],
    "marathon.quest": [":scope > div"],
    "marathon.questTitle": ["b"],
    "marathon.progressValue": [".progress span"],
    "marathon.description": ["p"],

    "news.article": [".js-mediator-article", "#content_body"],
    "news.title": ["#content_top h1", "h1"],
    "news.junk": ["img, script, style, iframe, .img_item_small_cont > span"],

    "promo.input": ["form[action*=\"pin.php\"] input[name=\"pin\"]", "input#pin", "input[name=\"pin\"]"],
    "promo.controls": [
      "input[type=\"submit\"], button[type=\"submit\"], button"
    ],
    "promo.content": ["#content_body"],
    "promo.title": ["h2"],
    "promo.error": ["#content_body .m_error", ".m_error"],
    "promo.rewardsBox": [".pin_bonuses_list"],
    "promo.rewards": [".pin_bonuses_list li"],
    "promo.choice": ["select"]
  },
  "texts": {
    "common.challengeTitle": ["Проверка безопасности"],
    "common.notLoggedIn": ["Вы не авторизованы"],

    "balance.notLoggedIn": [
      "Для доступа к разделу необходимо войти",
      "Ошибка авторизации"
    ],
    "balance.notLoggedInUrl": ["login.php", "vkplay"],

    "auth.welcome": ["Добро пожаловать"],

    "titles.skipHeading": ["Новости"],

    "marathon.noAccess": ["не имеете доступа"],

    "promo.buttonLabels": ["активировать", "ввести", "применить"],
    "promo.used": [
      "уже активировали",
      "уже активирован",
      "уже использован",
      "уже введен",
      "уже введён"
    ],
    "promo.expired": ["время действия", "срок действия", "истекло", "истёк", "истек"],
    "promo.invalid": [
      "не добавлены бонусы",
      "не существует",
      "недействител",
      "неверный",
      "не найден"
    ],
    "promo.empty": ["пустой пин-код"],
    "promo.success": ["успешно активировали"]
  },
  "regex": {
    "promo.reward": [
      "^(.*?)(?:\\s+x\\s*(\\d+))?\\s*\\(ID:\\s*(\\d+)\\)(?:,\\s*(.+))?$"
    ],
    "news.date": [
      "Обсудить\\s+(\\d{2}\\.\\d{2}\\.\\d{4})",
      "(\\d{2}\\.\\d{2}\\.\\d{4})"
    ]
  }
}
