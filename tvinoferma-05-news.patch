+ */
+export async function loadNewsPage(url, { dock = false, onTask } = {}) {
+  const task = startTask('📰 Разбор новости о марафоне', { dock }).watch('news');
+  onTask?.(task);
+  task.log(`Новость: ${url}`);
+  const wait = new Promise(r => { newsWaiter = r; });
